@inproceedings{bernard2017,
  author       = {Bernard, Sophie},
  title        = {Formalization of the {Lindemann}-{Weierstrass} Theorem},
  booktitle    = {Interactive Theorem Proving: 8th International Conference, {ITP} 2017, Bras{\'i}lia, Brazil, September 26--29, 2017, Proceedings},
  editor       = {Ayala-Rinc{\'o}n, Mauricio and Mu{\~n}oz, C{\'e}sar A.},
  series       = {Lecture Notes in Computer Science},
  volume       = {10499},
  pages        = {65--80},
  year         = {2017},
  month        = {September},
  address      = {Bras{\'i}lia, Brazil},
  publisher    = {Springer International Publishing},
  organization = {8th International Conference on Interactive Theorem Proving ({ITP} 2017)},
  doi          = {10.1007/978-3-319-66107-0_5},
  url          = {https://inria.hal.science/hal-01647563/document},
  isbn         = {978-3-319-66106-3},
  note         = {Author affiliation: Universit{\'e} C{\^o}te d'Azur, Inria, Valbonne, France (Sophie.Bernard@inria.fr). HAL Id: hal-01647563 (submitted 24 November 2017; record: https://inria.hal.science/hal-01647563). Publisher chapter: https://link.springer.com/chapter/10.1007/978-3-319-66107-0_5. Proceedings ISBN (print): 978-3-319-66106-3; ISBN (electronic): 978-3-319-66107-0. DBLP key: conf/itp/Bernard17. Abstract: This article details a formalization in Coq of the Lindemann-Weierstrass theorem, which gives a transcendence criterion for complex numbers: the theorem establishes a link between the linear independence of a set of algebraic numbers and the algebraic independence of the exponentials of these numbers. Following Baker's proof, the paper discusses the difficulties of its formalization and how they were resolved in Coq; most difficulties revolve around multivariate polynomials and their relationship with the conjugates of a univariate polynomial, leading to alternative forms of the fundamental theorem of symmetric polynomials. The development uses mainly the MathComp library for algebra and the Coquelicot library together with the Coq standard library of real numbers for analysis. At submission time the formalization relied on Coq 8.5, Coquelicot 2.1.2, and development versions of MathComp 1.6.1, multinomials, and finmap. To the authors' knowledge, this was the first formalization of the theorem in any proof assistant. Coq sources: http://www-sop.inria.fr/marelle/lindemann/; GitHub repository: https://github.com/Sobernard/Lindemann (opam package coq-lindemann). Related prior work: Bernard, Bertot, Rideau, and Strub, Formal proofs of transcendence for e and pi as an application of multivariate and symmetric polynomials (CPP 2016, DOI 10.1145/2854065.2854072)},
}

@misc{balonin2015,
  author       = {Балонин, Н.А.},
  title        = {Грамианы},
  year         = {2015},
  month        = {мая},
  language     = {russian},
  howpublished = {Интерактивная онлайн-глава сетевого учебника Internet {MATLAB} / {JM}},
  organization = {MathSciNet.ru},
  url          = {http://www.mathscinet.ru/systems/finitetime/gramian/},
  note         = {Глава курса «Системы финитного времени» (http://www.mathscinet.ru/systems/finitetime/), часть сетевой книги «Математика для сайтов и учебники он-лайн на её основе» (http://www.mathscinet.ru/). Метка времени страницы на сервере (файл 1432750771.super): 27 мая 2015 г. Интерактивные исполняемые примеры работают через движок JM (http://www.mathscinet.ru/zjun/jm.php). Параллельная справка: http://mathscinet.ru/imatlab/systems/index.php?help=20. Связанные справочные страницы в конце главы: матрица Сильвестра (http://mathscinet.ru/imatlab/systems/index.php?start=25&view=help), матрица Мироновского / кросс-грамиан (http://mathscinet.ru/imatlab/systems/index.php?start=30&view=help). Содержание: (1) определение матрицы Грама для системы векторов (функций); (2) грамиан управляемости для линейной системы dx/dt=Ax+Bu, y=Cx, из уравнения Ляпунова GA'+AG+BB'=0 (реакция на дельта-импульс); ортогональность по входу; (3) грамиан наблюдаемости по принципу двойственности Калмана, уравнение GA+A'G+C'C=0; ортогональность по выходу; положительная определённость при управляемости и наблюдаемости; (4) кросс-грамиан из GA+AG+BC=0 (также через riccati); для односвязных систем квадрат равен произведению грамианов управляемости и наблюдаемости; (5) ганкелевы сингулярные числа как модули собственных значений квадрата кросс-грамиана (со знаками --- алгебраические сингулярные числа); ганкелевы сингулярные функции; в примерах полубесконечный интервал заменяется конечным; ганкелев эксперимент (интервал управления предшествует интервалу наблюдения), итерационная оценка доминирующего ганкелева числа; (6) сбалансированное представление с равными диагональными грамианами; диагонализация через пучок матриц и подобие кросс-грамиана; (7) ортогональная редукция / внутренне доминирующая подсистема; ганкелева норма как наибольшее сингулярное число. Пример: A=[[-1,1],[0,-2]], B=[0,1], C=[1,1]; функции lyap, riccati, tf, lsim, eigs, mesh, putm. Связанная публикация автора с Л.~А.~Мироновским: «Спектральные характеристики линейных систем на ограниченном интервале времени», Автоматика и телемеханика, 2005, DOI 10.1023/A:1016154304227},
}

