#rocq-lemma("riccati_mono.v", "update_cov_mono", sketch: true, proof: false)

#rocq-lemma("riccati_mono.v", "riccati_step_psd", sketch: true, proof: false)

#rocq-lemma("riccati_mono.v", "riccati_step_mono", proof: false)

#rocq-lemma("riccati_mono.v", "riccati_iter0_mono", proof: false)

