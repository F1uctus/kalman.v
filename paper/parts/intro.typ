$
  EE vec(bold(w)_k, bold(v)_k, bold(x)_0) (bold(w)_j^*, bold(v)_j^*, bold(x)_0^*, 1)
  = lr(
    (#table(
        columns: 3,
        stroke: none,
        align: center + horizon,
        table.cell(rowspan: 2, $display(
          mat(
            Q, S;
            S^*, R
