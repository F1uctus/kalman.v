)

// Помощник для slides/*.typ: подаёт текст блока в заметки докладчика touying.
// `subslide: none` показывает заметку на всех подслайдах текущего слайда.
#let note(key) = speaker-note(
  subslide: none,
  speech.at(key, default: [Отсутствует заметка для ключа #key.]),
)

// =====================================================================
// Печатный сценарий. Рендерится при прямой компиляции файла; при импорте
// помощника `note` тело не выполняется.
// =====================================================================

#let to-sec(s) = {
  let p = s.split(":")
  int(p.at(0)) * 60 + int(p.at(1))
}
#let fmt(sec) = {
  let m = calc.floor(sec / 60)
  let s = calc.rem(sec, 60)
  str(m) + ":" + if s < 10 { "0" + str(s) } else { str(s) }
}

#let cumulative = order.fold((), (acc, k) => {
  acc + (acc.at(-1, default: 0) + to-sec(times.at(k)),)
})
#let total = cumulative.at(-1, default: 0)

#set document(title: "Сценарий доклада к защите ВКР")
#set page(
  paper: "a4",
  margin: (x: 2cm, top: 2cm, bottom: 1.6cm),
  numbering: "1",
)
#set text(lang: "ru", size: 11.5pt)
#set par(justify: true, leading: 0.62em)

#align(center)[
  #text(size: 17pt, weight: "bold", fill: unn-colors.primary)[
    Сценарий доклада к защите ВКР
  ]
  #v(3pt)
  #text(size: 12pt)[Формальная верификация фильтра Калмана и его свойств]
  #v(4pt)
  #text(size: 10pt, fill: luma(90))[
    Суммарно около #fmt(total).
  ]
]

#v(4pt)
#line(length: 100%, stroke: 0.6pt + unn-colors.panel)
#v(6pt)

#for (i, key) in order.enumerate() {
  block(
    width: 100%,
    breakable: false,
    fill: unn-colors.panel-light,
    inset: (x: 7pt, y: 5pt),
    radius: 3pt,
  )[
    #text(weight: "bold")[#str(i + 1). #titles.at(key)]
    #h(1fr)
    #text(size: 10pt, fill: luma(90))[
      бюджет #times.at(key) · итог #fmt(cumulative.at(i))
    ]
  ]
  block(inset: (left: 7pt, top: 4pt, bottom: 11pt))[#speech.at(key)]
}

#v(2pt)
#line(length: 100%, stroke: 0.6pt + unn-colors.panel)
#v(6pt)

#text(size: 13pt, weight: "bold", fill: unn-colors.primary)[
  Резервные слайды (для ответов на вопросы)
]
#v(6pt)

#for (i, key) in backup-order.enumerate() {
  block(
    width: 100%,
    breakable: false,
    fill: unn-colors.panel-light,
    inset: (x: 7pt, y: 5pt),
    radius: 3pt,
  )[
    #text(weight: "bold")[Р#str(i + 1). #titles.at(key)]
  ]
  block(inset: (left: 7pt, top: 4pt, bottom: 11pt))[#speech.at(key)]
}
