  "editor.glyphMargin": false,
  "editor.minimap.enabled": false,
  "editor.rulers": [80],
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "cmd": "'${workspaceFolder}/tools/rocq-comment-fmt/_build/default/bin/main.exe' --write '${file}'",
        "match": "/theories/.*\\.v$"
      }
    ]
  },
  "files.exclude": {
    "_build": true,
    "_opam": true,
    ".venv": true,
    "**/*.aux": true,
    "**/*.cache": true,
    "**/*.cmx": true,
    "**/*.cmxs": true,
    "**/*.coq-native": true,
    "**/*.glob": true,
    "**/*.vo": true,
    "**/*.vok": true,
    "**/*.vos": true,
    "**/paper": true
  },
  "git.ignoreLimitWarning": true,
  "tinymist.rootPath": "./paper",
  "tinymist.typstExtraArgs": ["--package-path", "./paper/packages/local"],
  "vsrocq.args": ["-R", "_build/default/theories", "Kalman"],
  "vsrocq.completion.enable": true,
  "vsrocq.goals.auto": true,
  "vsrocq.path": "./_opam/bin/vsrocqtop",
  "vsrocq.proof.mode": 0
}
