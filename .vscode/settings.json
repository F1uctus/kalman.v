{
  "vsrocq.path": "./_opam/bin/vsrocqtop",
  "files.exclude": {
    "_build": true,
    "**/*.glob": true,
    "**/*.cache": true,
    "**/*.aux": true,
    "**/*.vo": true,
    "**/*.vok": true,
    "**/*.vos": true,
    "**/*.coq-native": true
