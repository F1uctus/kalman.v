    "invmx",
    "Kalman",
    "lexx",
    "ltxx",
    "mathcomp",
    "Msym",
    "mulmx",
    "mult",
    "mxalgebra",
    "mxtrace",
    "nonneg",
    "obsv",
    "proofsketch",
    "Psym",
    "Rcov",
    "Rocq",
    "Setoid",
    "ssralg",
    "ssrnum",
    "Stdlib",
    "trmx",
    "unitmx",
    "аппроксимационный",
