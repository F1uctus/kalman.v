# Package metadata follows meta.yml. Keep the renderer pins synchronized with
# .nix/rocq2typst-source.nix when changing the renderer version.

opam-version: "2.0"
maintainer: "ilya.i.nikitin@proton.me"
version: "dev"

homepage: "https://github.com/F1uctus/kalman.v"
dev-repo: "git+https://github.com/F1uctus/kalman.v.git"
bug-reports: "https://github.com/F1uctus/kalman.v/issues"
license: "GPL-3.0-or-later"

synopsis: "Kalman filter formalization using Rocq, MathComp, Infotheo, CoqEAL, and CoqQ-adapted linear algebra"
description: """
Formalization of Kalman filter properties in Rocq using Mathematical
Components (MathComp), Infotheo, Coq Efficient Algebra Library (CoqEAL), and
proof techniques adapted from CoqQ (Coq-Quantum). The noise model and matrix
expectation operator build on Infotheo finite distributions; positive
definiteness and monotonicity lemmas adapt CoqQ Hermitian matrix algebra;
executable seqmx programs are linked to the abstract specification through
CoqEAL refinements."""

build: ["dune" "build" "-p" name "-j" jobs]
depends: [
  "coq" {>= "9.3" & < "9.4~"}
  "dune" {>= "3.21"}
  "rocq-elpi" {>= "3"}
  "rocq-hierarchy-builder" {>= "1.10.0"}
  "rocq-mathcomp-boot" {>= "2.6.0"}
  "rocq-mathcomp-order" {>= "2.6.0"}
  "rocq-mathcomp-finite-group" {>= "2.6.0"}
  "rocq-mathcomp-field" {>= "2.6.0"}
  "rocq-mathcomp-solvable" {>= "2.6.0"}
  "rocq-mathcomp-finmap" {>= "2.2.4"}
  "rocq-mathcomp-algebra" {>= "2.6.0"}
  "elpi" {>= "1.17.0"}
  "rocq-mathcomp-classical" {>= "1.19.0"}
  "rocq-mathcomp-reals" {>= "1.19.0"}
  "rocq-mathcomp-analysis" {>= "1.19.0"}
  "rocq-micromega-plugin" {>= "1.1.1"}
  "rocq-mathcomp-reals-stdlib" {>= "1.19.0"}
  "coq-interval" {>= "4.11.5"}
  "coq-flocq" {>= "4.2.2"}
  "coq-coquelicot" {>= "3.4.5"}
  "rocq-infotheo" {>= "0.9.9"}
  "rocq-bignums" {>= "9.0.0+rocq9.2"}
  "coq-coqeal" {>= "2.1.2"}
  "rocq2typst" {>= "0.2.0"}
  "rocq2typst-mathcomp" {>= "0.2.0"}
  "rocq2typst-analysis" {>= "0.2.0"}
  "rocq2typst-coqeal" {>= "0.2.0"}
  "rocq2typst-infotheo" {>= "0.2.0"}
]

pin-depends: [
  ["rocq2typst.0.2.0" "git+https://github.com/F1uctus/rocq2typst.git#f36a26a6d3f46f956b4b9fbee33a7766d7cc4478"]
  ["rocq2typst-mathcomp.0.2.0" "git+https://github.com/F1uctus/rocq2typst.git#f36a26a6d3f46f956b4b9fbee33a7766d7cc4478"]
  ["rocq2typst-analysis.0.2.0" "git+https://github.com/F1uctus/rocq2typst.git#f36a26a6d3f46f956b4b9fbee33a7766d7cc4478"]
  ["rocq2typst-coqeal.0.2.0" "git+https://github.com/F1uctus/rocq2typst.git#f36a26a6d3f46f956b4b9fbee33a7766d7cc4478"]
  ["rocq2typst-infotheo.0.2.0" "git+https://github.com/F1uctus/rocq2typst.git#f36a26a6d3f46f956b4b9fbee33a7766d7cc4478"]
]

tags: [
  "category:Mathematics/Algebra"
  "keyword:Kalman filter"
  "keyword:linear algebra"
  "keyword:mathematical components"
  "logpath:Kalman"
]
authors: [
  "Ilya I. Nikitin"
]
