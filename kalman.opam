opam-version: "2.0"
maintainer: "ilya.i.nikitin@proton.me"
version: "dev"

homepage: "https://github.com/F1uctus/kalman.v"
dev-repo: "git+https://github.com/F1uctus/kalman.v.git"
bug-reports: "https://github.com/F1uctus/kalman.v/issues"
license: "GPL-3.0-or-later"

synopsis: "Kalman filter formalization using Rocq, MathComp, Infotheo, CoqEAL, and CoqQ-adapted linear algebra"
description: """
Formalization of Kalman filter properties in Rocq using Mathematical
Components (MathComp), Infotheo, Coq Efficient Algebra Library (CoqEAL), and
proof techniques adapted from CoqQ (Coq-Quantum). The noise model and matrix
expectation operator build on Infotheo finite distributions; positive
definiteness and monotonicity lemmas adapt CoqQ Hermitian matrix algebra;
executable seqmx programs are linked to the abstract specification through
CoqEAL refinements."""

build: ["dune" "build" "-p" name "-j" jobs]
depends: [
  "dune" {>= "3.6"}
  "coq" {>= "9.0" & < "9.2~"}
  "dune" {>= "3.21"}
  "rocq-elpi" {>= "3"}
  "rocq-hierarchy-builder" {>= "1.9.0"}
  "rocq-mathcomp-boot" {>= "2.5.0"}
  "rocq-mathcomp-order" {>= "2.5.0"}
  "rocq-mathcomp-fingroup" {>= "2.5.0"}
  "rocq-mathcomp-field" {>= "2.5.0"}
  "rocq-mathcomp-solvable" {>= "2.5.0"}
  "rocq-mathcomp-finmap" {>= "2.1.0"}
  "rocq-mathcomp-algebra" {>= "2.5.0"}
  "elpi" {>= "1.17.0"}
  "rocq-mathcomp-classical" {>= "1.16.0"}
  "rocq-mathcomp-reals" {>= "1.16.0"}
  "rocq-mathcomp-analysis" {>= "1.16.0"}
  "coq-mathcomp-zify" {>= "1.6.0"}
  "coq-infotheo" {>= "0.9.7"}
  "rocq-bignums" {>= "9.0.0+rocq9.1"}
  "coq-coqeal" {>= "2.1.1"}
  "rocq2typst" {>= "0.1.0"}
  "rocq2typst-mathcomp" {>= "0.1.0"}
  "rocq2typst-analysis" {>= "0.1.0"}
  "rocq2typst-coqeal" {>= "0.1.0"}
  "rocq2typst-infotheo" {>= "0.1.0"}
]

tags: [
  "category:Mathematics/Algebra"
